{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "14 days",
  "automerge": true,
  "labels": ["dependency"],
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "labels": ["bump:major"]
    },
    {
      "matchUpdateTypes": ["minor"],
      "labels": ["bump:minor"]
    },
    {
      "matchUpdateTypes": ["patch"],
      "labels": ["bump:patch"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["Dockerfile"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\nARG AICHAT_VERSION=(?<currentValue>[0-9][\\w.-]*)\\nARG AICHAT_SHA256=(?<currentDigest>[a-f0-9]{64})"
      ]
    }
  ]
}
