{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "14 days",
  "automerge": true,
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "labels": ["bump:major", "enhancement"]
    },
    {
      "matchUpdateTypes": ["minor"],
      "labels": ["bump:minor", "enhancement"]
    },
    {
      "matchUpdateTypes": ["patch"],
      "labels": ["bump:patch"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [".*"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\n[A-Z_]+=(?<currentValue>[0-9][\\w.-]*)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["Dockerfile"],
      "matchStrings": [
        "# renovate: datasource=docker depName=alpine\\nARG ALPINE_VERSION=(?<currentValue>[0-9][\\w.-]*)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "alpine"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["Dockerfile"],
      "matchStrings": [
        "# renovate: datasource=github-release-attachments depName=sigoden/aichat\\nARG AICHAT_VERSION=(?<currentValue>[0-9][\\w.-]*)"
      ],
      "datasourceTemplate": "github-release-attachments",
      "depNameTemplate": "sigoden/aichat",
      "currentValueTemplate": "{{tag}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["Dockerfile"],
      "matchStrings": [
        "# renovate: datasource=github-release-attachments depName=sigoden/aichat\\nARG AICHAT_SHA256=(?<currentDigest>[a-f0-9]{64})"
      ],
      "datasourceTemplate": "github-release-attachments",
      "depNameTemplate": "sigoden/aichat",
      "currentDigestTemplate": "{{checksum}}"
    }
  ]
}
